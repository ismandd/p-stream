{
  "packageManager": "pnpm@10.5.2",
  "name": "P-Stream",
  "version": "5.3.7",
  "private": true,
  "homepage": "https://github.com/ismandd/p-stream",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pwa": "cross-env VITE_PWA_ENABLED=true vite build",
    "update-and-build": "pnpm remove @p-stream/providers && pnpm add github:p-stream/providers#production && pnpm run build",
    "update-providers": "pnpm update @p-stream/providers",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "preinstall": "npx -y only-allow pnpm"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@formkit/auto-animate": "^0.9.0",
    "@headlessui/react": "^2.2.0",
    "@ladjs/country-language": "^1.1.0",
    "@marsidev/react-turnstile": "^1.4.2",
    "@noble/hashes": "^1.12.0",
    "@p-stream/providers": "github:ismandd/providers#production",
    "@plasmohq/messaging": "^0.8.0",
    "@react-spring/web": "^10.0.3",
    "@scure/bip39": "^1.6.0",
    "@sozialhelden/ietf-language-tags": "^5.5.0",
    "@types/node-forge": "^1.3.14",
    "classnames": "^2.5.1",
    "core-js": "^3.48.0",
    "detect-browser": "^6.0.0",
    "dompurify": "^3.3.3",
    "flag-icons": "^7.5.0",
    "focus-trap-react": "^11.0.0",
    "fscreen": "^1.2.0",
    "fuse.js": "^7.1.0",
    "hls.js": "^1.6.15",
    "i18next": "^25.10.4",
    "immer": "^11.0.0",
    "iso-639-3": "^3.0.1",
    "jwt-decode": "^4.0.0",
    "lodash.merge": "^4.6.2",
    "million": "^3.1.10",
    "nanoid": "^5.1.0",
    "node-forge": "^1.3.1",
    "ofetch": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-ga4": "^2.1.0",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^16.6.0",
    "react-lazy-with-preload": "^2.2.1",
    "react-router-dom": "^7.13.1",
    "react-sticky-el": "^2.1.1",
    "react-use": "^17.6.0",
    "semver": "^7.7.3",
    "slugify": "^1.6.6",
    "subsrt-ts": "^2.2.0",
    "wyzie-lib": "^2.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^11.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"],
      "allowedVersions": {
        "react": "19",
        "react-dom": "19"
      }
    }
  }
}
